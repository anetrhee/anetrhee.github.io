---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import Cover from '../components/Cover.astro';
import Stat from '../components/Stat.astro';
import { person, work, education, community, skills, stats } from '../data/resume';

const title = `Info — ${person.first} ${person.last}`;
const description = `About ${person.first} ${person.last}: education, experience, community, skills and interests.`;
const serviceHours = stats.find((s) => s.label === 'Service hours')!;
// Swap for '/assets/portrait.jpg' once the portrait exists (1200x1500).
const portrait: string | undefined = undefined;
---
<Base title={title} description={description} current="info">
  <!-- ===== About ===== -->
  <section class="about wrap" aria-labelledby="about-title">
    <div class="grid">
      <Label text="Info" class="about__label" />
      <h1 id="about-title" class="display about__title" data-split>
        About <span class="serif">{person.first}</span>
      </h1>

      <div class="about__portrait" data-clip>
        <Cover title={`${person.first} ${person.last}`} kicker="Portrait" num={person.monogram} image={portrait} alt={`Portrait of ${person.first} ${person.last}`} ratio="4 / 5" />
      </div>

      <div class="about__bio">
        {person.bio.map((p, i) => (
          <p class:list={[i === 0 ? 'lead' : 'body-l muted']} data-fade-lines>{p}</p>
        ))}
        <a href={`mailto:${person.email}`} class="about__mail ui text-link" data-fade>{person.email}</a>
      </div>
    </div>
  </section>

  <!-- ===== Education ===== -->
  <section class="section wrap block" aria-labelledby="edu-title">
    <div class="grid">
      <Label text="Education" class="block__label" />
      <div class="block__body">
        <p class="ui muted">{education.expected}</p>
        <h2 id="edu-title" class="h2" data-split>{education.school}</h2>
        <ul class="edu__degrees" data-stagger>
          {education.degrees.map((d) => <li class="h3"><span class="serif">{d}</span></li>)}
        </ul>
        <div class="edu__extra">
          <h3 class="ui muted">Additional</h3>
          <ul data-stagger>{education.additional.map((a) => <li class="body-l">{a}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Experience accordion ===== -->
  <section class="section wrap block" aria-labelledby="exp-title">
    <div class="grid">
      <Label text="Experience" class="block__label" />
      <div class="block__body">
        <h2 id="exp-title" class="h2" data-split>Experience</h2>
        <ul class="acc">
          {work.map((w, i) => (
            <li class="acc__item" data-accordion>
              <h3>
                <button class="acc__btn" type="button" aria-expanded="false" aria-controls={`acc-${w.slug}`} id={`accb-${w.slug}`} data-accordion-btn>
                  <span class="acc__num ui muted">0{i + 1}</span>
                  <span class="acc__title"><span>{w.orgLead}</span> <span class="serif">{w.orgTail}</span></span>
                  <span class="acc__meta ui"><span>{w.role}</span><span class="muted">{w.dates}</span></span>
                  <span class="acc__icon" aria-hidden="true"><i></i><i></i></span>
                </button>
              </h3>
              <div class="acc__panel" id={`acc-${w.slug}`} role="region" aria-labelledby={`accb-${w.slug}`} data-accordion-panel>
                <div class="acc__content">
                  <p class="ui muted">{w.org}{w.location && ` · ${w.location}`}</p>
                  <ul class="acc__bullets">{w.bullets.map((b) => <li>{b}</li>)}</ul>
                  <ul class="acc__tags ui">{w.tags.map((t) => <li>{t}</li>)}</ul>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== Community ===== -->
  <section class="section wrap block" aria-labelledby="comm-title">
    <div class="grid">
      <Label text="Community" class="block__label" />
      <div class="block__body">
        <h2 id="comm-title" class="h2" data-split>Community</h2>
        <div class="comm">
          {community.map((c) => (
            <article class="comm__item" data-fade>
              <p class="ui accent">{c.meta}</p>
              <h3 class="h3">{c.title}</h3>
              <ul class="acc__bullets">{c.bullets.map((b) => <li>{b}</li>)}</ul>
            </article>
          ))}
          <Stat value={serviceHours.value} suffix={serviceHours.suffix} label={serviceHours.label} class="comm__stat" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Skills & Interests ===== -->
  <section class="section wrap block" aria-labelledby="sk-title">
    <div class="grid">
      <Label text="Skills & Interests" class="block__label" />
      <div class="block__body">
        <h2 id="sk-title" class="h2" data-split>Skills & <span class="serif">interests</span></h2>
        <div class="sk">
          <div class="sk__col"><h3 class="ui muted">Tools</h3><ul data-stagger>{skills.tools.map((s) => <li>{s}</li>)}</ul></div>
          <div class="sk__col"><h3 class="ui muted">Capabilities</h3><ul data-stagger>{skills.capabilities.map((s) => <li>{s}</li>)}</ul></div>
          <div class="sk__col"><h3 class="ui muted">Interests</h3><ul data-stagger>{skills.interests.map((s) => <li>{s.name}</li>)}</ul></div>
          <div class="sk__col"><h3 class="ui muted">Languages</h3><ul data-stagger>{skills.languages.map((s) => <li>{s}</li>)}</ul></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .about { padding-top: calc(var(--header-h) + clamp(4rem, 12vw, 9rem)); }
  .about .grid { row-gap: 2.5rem; }
  .about__label { grid-column: 1 / -1; }
  .about__title { grid-column: 1 / -1; }
  .about__portrait { grid-column: 1 / 5; border-radius: 0.5rem; overflow: hidden; margin-top: 2rem; }
  .about__bio { grid-column: 6 / 12; align-self: end; display: flex; flex-direction: column; gap: 1.5rem; }
  .about__mail { align-self: flex-start; margin-top: 0.5rem; }

  .block .grid { row-gap: 1.5rem; }
  .block__label { grid-column: 1 / 3; padding-top: 0.6em; }
  .block__body { grid-column: 3 / 13; display: flex; flex-direction: column; gap: 1.5rem; }

  .edu__degrees { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.5rem; }
  .edu__extra { display: flex; flex-direction: column; gap: 0.9rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }

  .acc { margin-top: 1.5rem; }
  .acc__item { border-top: 1px solid var(--line); }
  .acc__item:last-child { border-bottom: 1px solid var(--line); }
  .acc__btn {
    width: 100%;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 14rem) 2rem;
    gap: var(--gutter);
    align-items: center;
    padding: 1.5rem 0;
    text-align: left;
  }
  .acc__title { font-size: clamp(1.75rem, 3.6vw, 3.25rem); letter-spacing: -0.035em; line-height: 1; transition: transform 0.8s var(--ease-out-quint); }
  .acc__btn:hover .acc__title { transform: translateX(0.75rem); }
  .acc__meta { display: flex; flex-direction: column; gap: 0.35rem; }
  .acc__icon { position: relative; width: 1rem; height: 1rem; justify-self: end; }
  .acc__icon i { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; transition: transform 0.5s var(--ease-out-quint); }
  .acc__icon i:last-child { transform: rotate(90deg); }
  .acc__item.is-open .acc__icon i:last-child { transform: rotate(0deg); }
  .acc__item.is-open .acc__icon { color: var(--accent); }
  .acc__content { padding: 0 0 2rem calc(3rem + var(--gutter)); display: flex; flex-direction: column; gap: 1.25rem; max-width: 52rem; }
  .acc__bullets { display: flex; flex-direction: column; gap: 0.6rem; }
  .acc__bullets li { position: relative; padding-left: 1.4rem; font-size: clamp(1.0625rem, 1.4vw, 1.25rem); line-height: 1.4; }
  .acc__bullets li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 0.6rem; height: 1px; background: var(--accent); }
  .acc__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .acc__tags li { border: 1px solid var(--line); border-radius: 999px; padding: 0.45em 0.8em; }

  .comm { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem var(--gutter); margin-top: 1.5rem; }
  .comm__item { border-top: 1px solid var(--line); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
  .comm :global(.comm__stat) { grid-column: 1 / -1; border-top: 1px solid var(--line); padding-top: 1.25rem; }

  .sk { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem var(--gutter); margin-top: 1.5rem; }
  .sk__col { border-top: 1px solid var(--line); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 1.1rem; }
  .sk__col li { font-size: clamp(1.0625rem, 1.4vw, 1.375rem); letter-spacing: -0.02em; line-height: 1.45; }

  @media (max-width: 1023px) { .sk { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .about__portrait { grid-column: 1 / -1; }
    .about__bio { grid-column: 1 / -1; }
    .block__label, .block__body { grid-column: 1 / -1; }
    .acc__btn { grid-template-columns: 2rem minmax(0, 1fr) 1.25rem; }
    .acc__meta { grid-column: 2 / 3; grid-row: 2; }
    .acc__icon { grid-column: 3; grid-row: 1; }
    .acc__content { padding-left: calc(2rem + var(--gutter)); }
    .comm { grid-template-columns: 1fr; }
    .sk { grid-template-columns: 1fr; }
  }
</style>
