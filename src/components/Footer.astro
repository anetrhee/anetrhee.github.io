---
import Clock from './Clock.astro';
import Arrow from './Arrow.astro';
import { person } from '../data/resume';
---
<footer class="footer" id="contact" data-footer>
  <div class="footer__sky" data-inview-play aria-hidden="true">
    <span class="blob blob--1"></span>
    <span class="blob blob--2"></span>
    <span class="blob blob--3"></span>
    <span class="blob blob--4"></span>
  </div>

  <div class="footer__inner wrap">
    <p class="footer__mail">
      <a href={`mailto:${person.email}`} class="footer__email" data-email-link>
        <span>{person.email}</span>
        <Arrow dir="diag" />
      </a>
    </p>

    <div class="footer__bottom">
      <p class="footer__wordmark" aria-label={`${person.first} ${person.last}`}>
        <span>{person.first}</span>&nbsp;<span class="serif">{person.last}</span>
      </p>

      <div class="footer__bar grid ui">
        <Clock class="footer__clock" />
        <p class="footer__mid">
          <span>Designer &amp; Storyteller</span>
          <span class="footer__slash" aria-hidden="true">/</span>
          <a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="text-link">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          <span class="footer__slash" aria-hidden="true">/</span>
          <span>©{person.year}</span>
        </p>
        <button type="button" class="footer__top-btn" data-back-top>
          <Arrow dir="up" />
          <span data-scramble-hover>Back to top</span>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: sticky;
    bottom: 0;
    z-index: 1;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    background: var(--bg-2);
    display: flex;
  }

  /* soft, slowly drifting blurred colour field */
  .footer__sky { position: absolute; inset: -20%; filter: blur(70px); }
  .blob {
    position: absolute;
    border-radius: 50%;
    animation: drift 22s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  .footer__sky.is-playing .blob { animation-play-state: running; }
  .blob--1 { width: 55%; height: 60%; left: 5%; top: 10%; background: var(--blush); }
  .blob--2 { width: 45%; height: 55%; right: 5%; top: 5%; background: var(--mauve); animation-duration: 26s; animation-delay: -6s; }
  .blob--3 { width: 50%; height: 45%; left: 30%; bottom: 8%; background: var(--butter); animation-duration: 30s; animation-delay: -12s; }
  .blob--4 { width: 30%; height: 35%; left: 45%; top: 30%; background: #fbf7f2; animation-duration: 18s; animation-delay: -3s; }
  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(6%, -5%) scale(1.12); }
    100% { transform: translate(-5%, 4%) scale(0.94); }
  }
  @media (prefers-reduced-motion: reduce) { .blob { animation: none; } }

  .footer__inner {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 0.9rem;
  }

  .footer__mail { text-align: center; margin-top: 18vh; }
  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
    transition: color 0.5s var(--ease-out-quint);
  }
  .footer__email:hover { color: var(--accent); }
  .footer__email :global(.arrow-box) { width: 0.6em; height: 0.6em; }

  .footer__wordmark {
    font-size: clamp(3.5rem, 18.6vw, 30rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    white-space: nowrap;
    text-align: center;
    padding-bottom: 0.04em;
    background: linear-gradient(100deg, #231d1a 0%, #5a3a33 45%, #a8584b 75%, #c98f7e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .footer__wordmark .serif { letter-spacing: -0.02em; }

  .footer__bar { align-items: center; margin-top: 0.9rem; }
  .footer__clock { grid-column: 1 / 4; }
  .footer__mid { grid-column: 4 / 10; justify-self: center; display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; }
  .footer__slash { color: var(--fg-2); }
  .footer__top-btn {
    grid-column: 10 / 13;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 44px;
    text-transform: inherit;
    letter-spacing: inherit;
  }
  .footer__top-btn :global(.arrow-box) { width: 1em; height: 1em; }

  @media (max-width: 767px) {
    .footer__clock { grid-column: 1 / 7; }
    .footer__top-btn { grid-column: 7 / 13; }
    .footer__mid { grid-column: 1 / -1; grid-row: 2; justify-self: start; justify-content: flex-start; }
    .footer__email { font-size: 1.6rem; }
    .footer__wordmark { font-size: 16.6vw; }
  }
</style>
